# Example for an AP interface statically configured as 192.168.4.1/24.
# Replace the domain with the publicly trusted DNS-01 certificate hostname.
interface=wlan0
bind-interfaces
dhcp-range=192.168.4.20,192.168.4.200,255.255.255.0,12h
dhcp-option=3,192.168.4.1
dhcp-option=6,192.168.4.1
address=/box.example.org/192.168.4.1
