# Copy to .env (or run `make env`, which fills every CHANGE_ME with random values).
# Regtest only. Never put mainnet secrets in this file.

COMPOSE_PROJECT_NAME=coupure
DEMO_MODE=1

# bitcoind (regtest, behind the uplink)
BITCOIN_RPC_USER=coupure
BITCOIN_RPC_PASSWORD=CHANGE_ME

# Postgres
POSTGRES_PASSWORD=CHANGE_ME
MINT_DB_PASSWORD=CHANGE_ME
COUPURED_RO_PASSWORD=CHANGE_ME

# Nutshell mint. BIP-39 seed for the mint keysets (MINT_PRIVATE_KEY is deprecated since 0.22.0).
# `make env` generates a fresh 12-word mnemonic.
MINT_MNEMONIC=CHANGE_ME
MINT_INFO_NAME="Coupure — Marché Tilène (démo)"
MINT_INFO_CONTACT_NPUB=

# Uplink control API (only served when DEMO_MODE=1). At least 24 chars.
UPLINK_TOKEN=CHANGE_ME

# Port the box serves the wallet on (phones join the LAN and open http://<box>:$HTTP_PORT)
HTTP_PORT=8080
